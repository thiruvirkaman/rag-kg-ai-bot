# --- Data source ---
SOURCE_URL=https://www.tn.gov.in/scheme_list.php?dep_id=Mg==
SOURCE_BASE=https://www.tn.gov.in
DEPARTMENT_NAME=Agriculture - Farmers Welfare Department
DEPARTMENT_ID=Mg==

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# --- LLM (Ollama Cloud, OpenAI-compatible endpoint) ---
# Docs: https://docs.ollama.com/cloud
# Cloud models: drop the "-cloud" suffix in API calls (e.g. gemma4:31b not gemma4:31b-cloud)
LLM_BASE_URL=https://ollama.com/v1
LLM_API_KEY=b8c7a8953af14299b84f94c1197cc23e.YxVj14WZz0z10WZEbj335cFk
LLM_CHAT_MODEL=gemma4:31b
LLM_EXTRACT_MODEL=gemma4:31b
LLM_TEMPERATURE=0.1

# --- Embeddings (Ollama nomic-embed-text, 768-dim) ---
# nomic-embed-text is local-only on Ollama; run via local daemon.
EMBED_BASE_URL=http://localhost:11434/v1
EMBED_API_KEY=ollama
EMBED_MODEL=nomic-embed-text
EMBED_DIMENSIONS=768

# --- Retrieval ---
RETRIEVAL_TOP_K=6
RETRIEVAL_HOPS=2

# --- App ---
APP_TITLE=TN Farmers Schemes - Knowledge Graph Assistant
LOG_LEVEL=INFO